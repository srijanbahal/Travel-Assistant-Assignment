# InviGrid Travel Assistant Environment Variables
# Copy this file to .env and fill in your values

# Required: Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google AI API Key (fallback if Groq unavailable)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Database URL (defaults to SQLite if not set)
# DATABASE_URL=postgresql://user:password@localhost:5432/travel_db
